<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSystemExtensionUsageDescription</key>
	<string>This extension manages the network connections.</string>
	<key>NetworkExtension</key>
	<dict>
		<key>NEMachServiceName</key>
		<string>$(TeamIdentifierPrefix)group.ch.protonvpn.mac.WireGuard-Extension</string>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.packet-tunnel</key>
			<string>$(PRODUCT_MODULE_NAME).PacketTunnelProvider</string>
			<key>com.apple.networkextension.filter-packet</key>
			<string>$(PRODUCT_MODULE_NAME).PacketFilterProvider</string>
		</dict>
	</dict>
    <key>TeamIdentifierPrefix</key>
    <string>$(TeamIdentifierPrefix)</string>
</dict>
</plist>
